# Copy to .env. Never commit .env.
# The deployer key only pays gas. It is not the owner.
# OWNER is your wallet. You alone mint, upgrade, pause, and sign.

DEPLOYER_PRIVATE_KEY=0x
OWNER=0x0000000000000000000000000000000000000000
# Optional. Defaults to OWNER.
# ADMIN=0x
# EXPECTED_SIGNER=0x

BOTCHAIN_TESTNET_RPC=https://rpc.bohr.life
BOTCHAIN_MAINNET_RPC=https://rpc.botchain.ai
